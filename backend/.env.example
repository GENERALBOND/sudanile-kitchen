# Copy this file to .env and fill in real values. NEVER commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave blank (or unset) to use SQLite locally.
# In production use a PostgreSQL URL, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=

# Media storage — leave blank to store files locally (development).
# In production set these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase project ID used to verify ID tokens server-side
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Cloud Messaging (push notifications).
# Path to the service-account JSON downloaded from the Firebase console
# (Project settings -> Service accounts -> Generate new private key).
# Alternatively set FIREBASE_SERVICE_ACCOUNT_JSON to the JSON contents, or
# FIREBASE_SERVICE_ACCOUNT_BASE64 to its base64-encoded form (recommended for
# single-line env vars on Render), or rely on GOOGLE_APPLICATION_CREDENTIALS.
# Leave all blank to disable push.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Email — sent through Brevo's transactional REST API (HTTPS), which works
# from cloud hosting (Render blocks outbound SMTP). Free tier = 300 emails/day.
# Get a key under Brevo -> SMTP & API -> API keys (transactional).
BREVO_API_KEY=your-brevo-api-key
# Must be a verified sender in Brevo (Settings -> Senders & IPs), e.g. your
# Brevo login email. Emails are sent from this address.
DEFAULT_FROM_EMAIL=your-brevo-login-email
# Display name on the From line (Brevo rejects an empty sender name).
BREVO_SENDER_NAME=Sudanile Kitchen

# Optional: demo login hint shown on the admin landing page (leave blank to hide)
DEMO_LOGIN_HINT=
