# Copy this file to .env and fill in real values. NEVER commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave blank (or unset) to use SQLite locally.
# In production use a PostgreSQL URL, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=

# Media storage — leave blank to store files locally (development).
# In production set these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase project ID used to verify ID tokens server-side
FIREBASE_PROJECT_ID=your-firebase-project-id

# Email (SMTP) — EMAIL_HOST_PASSWORD is a Gmail App Password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Optional: demo login hint shown on the admin landing page (leave blank to hide)
DEMO_LOGIN_HINT=
