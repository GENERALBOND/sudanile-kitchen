# Copy to .env and fill in real values. NEVER commit .env.
# Build with:  flutter run --dart-define-from-file=.env
# (Android release signing also needs STORE_PASSWORD / KEY_PASSWORD exported —
#  see android/app/build.gradle.kts)

# Backend API
API_BASE_URL=http://localhost:8000/api

# Firebase project id
FIREBASE_PROJECT_ID=your-firebase-project-id

# Web app
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MEASUREMENT_ID=

# Android app
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_ANDROID_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_STORAGE_BUCKET=

# iOS app
FIREBASE_IOS_API_KEY=
FIREBASE_IOS_APP_ID=
FIREBASE_IOS_MESSAGING_SENDER_ID=
FIREBASE_IOS_PROJECT_ID=
FIREBASE_IOS_STORAGE_BUCKET=
FIREBASE_IOS_BUNDLE_ID=

# Google Sign-In (OAuth web client ID used as serverClientId)
GOOGLE_WEB_CLIENT_ID=
